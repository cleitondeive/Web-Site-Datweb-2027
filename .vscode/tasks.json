{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Datweb: iniciar prévia",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "datweb",
        "pattern": { "regexp": "^(.*):(\\d+):(\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "message": 4 },
        "background": { "activeOnStart": true, "beginsPattern": "^Iniciando o Datweb", "endsPattern": "^Datweb local:" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Datweb: verificar projeto",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
